{
    "name": "warsztat/sklep-agentow-qa",
    "description": "Narzędzia deweloperskie QA repo (phpcs/phpstan) — NIE część paczek klienta; paczki wtyczek budowane są z katalogów wtyczki/*.",
    "license": "proprietary",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=512M"
    }
}
