<?xml version="1.0"?>
<ruleset name="SklepAgentow">
	<description>Styl kodu wtyczek (plan §7): WordPress Coding Standards; bez i18n (D21 — teksty polskie wprost).</description>

	<!-- Zakres: wszystkie 3 wtyczki. Boty dołączone 19.08 (D25 — jednym ruchem z przebudową
	     paczek i powtórką weryfikacji zipów, przy wrogiej sesji botów). -->
	<file>wtyczki/sklep-agentow</file>
	<file>wtyczki/chatbot-live</file>
	<file>wtyczki/segregator-maila</file>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<arg name="parallel" value="4"/>

	<rule ref="WordPress">
		<!-- D21: świadomie bez i18n/textdomain (mina „textdomain too early" WP 6.7+). -->
		<exclude name="WordPress.WP.I18n"/>
		<!-- Format docblocków (@package, @param wszędzie) to wymóg rdzenia WP, nie Handbooka;
		     treść komentarzy pilnuje recenzent PR. Zakaz var_dump/error_log zostaje
		     (WordPress.PHP.DevelopmentFunctions — włączony). -->
		<exclude name="WordPress-Docs"/>
	</rule>

	<!-- D25: własny sanitizer chatbota (front.php: allowlist regex ^[a-zA-Z0-9-]{8,64}$,
	     pusty string przy odrzucie) — sniff ma go uznawać za funkcję sanityzującą. -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="chatl_waliduj_sesje"/>
				<!-- 1.4.0: własny sanitizer kolorów (wyglad.php) — regex ^#[0-9a-f]{6}$
				     po rozwinięciu skrótu, pusty string przy odrzucie, a wywołujący
				     podstawia wtedy wartość domyślną. -->
				<element value="chatl_sanitize_kolor"/>
			</property>
		</properties>
	</rule>

	<!-- D25 (uzupełnienie 19.08): boty trzymają CAŁY stan we własnych tabelach
	     (architektura §4B — sprawdzone: wszystkie 69 trafień sniffa to własne tabele
	     chatl_*/segm_*), więc rada „użyj API WP / dołóż cache" nie ma tam adresata —
	     wyłączamy TYLKO ten doradczy sniff i TYLKO dla botów, jedną deklaracją zamiast
	     ~30 rozsianych bloków disable/enable. Sniffy bezpieczeństwa SQL
	     (WordPress.DB.PreparedSQL, esc_like przy LIKE) zostają aktywne wszędzie.
	     Sklep miesza wp_options z tabelami — tam uczciwy zakres to bloki inline. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>wtyczki/chatbot-live/*</exclude-pattern>
		<exclude-pattern>wtyczki/segregator-maila/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.7"/>
</ruleset>
